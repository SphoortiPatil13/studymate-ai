# write a program that iterates over elements as many times as its count
print("Program that iterates over elements as many times as its count:")
l=[1,2,3,4,4,2,3,1,3,2,1,2]
d={}
for i in l:
    if i in d:
        d[i]+=1
    else:
        d[i]=1
for key,value in d.items():
    for i in range(value):
        print(key)
print("--------------------------------------------------------------------------")

# write a program that iterates through words/elements and displays only the element at a given index and breaks at the third index
print("iterates over specified index and breaks at third index: ")
s=input("enter a string:")
l=s.split()
ind=int(input("enter the index:"))
for i in range(len(l)):
    if i == ind:
        print(l[i])
    if i ==3:
        break
print("--------------------------------------------------------------------------")

# to find the occurence of 10 most common words
print("Occurrence of 10 most common words:")
from collections import Counter
txt=input("Enter text: ").lower().split()
count=Counter(txt)
for word,c in count.most_common(10):
    print(word,"-",c)
print("--------------------------------------------------------------------------")


# create a deque and perform append , remove and reverse operations
print("Operations on deque:")
from collections import deque
d=deque([12,23,34,45])
print("Original deque: ",d)
d.append(56)
print("After appending: ",d)
d.remove(34)
print("After removing: ",d)
d.reverse()
print("Reverse: ",d)
print("--------------------------------------------------------------------------")

# creating a set of duplicates from list
print("Set of duplicate elements of a list:")
l=eval(input("Enter a list:"))
l1=[x for x in l if l.count(x)>1]
s=set(l1)
print(s)
print("--------------------------------------------------------------------------")


# total revenue product-wise
print("Product - wise total revenue: ")
sales=[("Rice",1300),
      ("Wheat",2600),
      ("Ragi",900),
      ("Wheat",1100),
      ("Rice",2800)
      ]
d={}
for i in sales:
    if i[0] in d:
        d[i[0]]+=i[1]
    else:
        d[i[0]]=i[1]
print(d)
print("--------------------------------------------------------------------------")
